{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "seleniumbase-runner",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-08",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "containers": [
    {
      "class_name": "SeleniumBaseContainer",
      "image": "../../Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-3",
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "SELENIUMBASE_RUNNER",
        "class_name": "SeleniumBaseContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SeleniumBaseContainer"]
    }
  ]
}
